{
  "name": "dsh-tableau-twb-viewer",
  "version": "0.3.0",
  "description": "DeepSeek Harness (DSH) plugin — inspect a Tableau workbook (.twb) in the browser: 1:1 SVG dashboard layout, field-level lineage graph, datasource / calculated-field metadata. Read-only metadata; .twbx refused by design.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/client.js",
    "sample.twb",
    "cordis.patch.yml",
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "gen-css": "node gen-css.mjs",
    "verify": "node test/verify.mjs",
    "verify:update": "node test/verify.mjs --update",
    "verify:reference": "node test/verify-reference.mjs",
    "bench": "node test/bench.mjs",
    "e2e": "node test/e2e-ui.mjs",
    "screenshots": "node test/screenshots.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tableau",
    "twb",
    "workbook",
    "data-lineage",
    "visualization"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tableau-China/dsh-tableau-twb-viewer.git"
  },
  "homepage": "https://github.com/tableau-China/dsh-tableau-twb-viewer#readme",
  "bugs": {
    "url": "https://github.com/tableau-China/dsh-tableau-twb-viewer/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
